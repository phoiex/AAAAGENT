{
  "name": "desktop-pet",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build-wechat.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tools/run-tests.mjs",
    "test:release": "npm run build && node tools/run-tests.mjs release",
    "build:wake": "node tools/build-wake.mjs",
    "build:desktop": "node desktop/build-web.mjs && node desktop/build-presentation-preview.mjs",
    "build:native": "node tools/build-native.mjs",
    "doctor": "node tools/release-doctor.mjs",
    "dev": "npm run build && npm run build:desktop && node tools/dev-desktop.mjs",
    "start": "node dist/app/trial-launcher.js",
    "configure": "node tools/configure-local.mjs",
    "build:windows": "npm run build && npm run build:desktop && npm run build:wake && npm run build:native",
    "test:windows": "npm run build && node tools/run-tests.mjs windows",
    "test:stress": "npm run build && node --test --test-concurrency=1 tests/windows-stress.test.mjs",
    "test:windows:ui": "npm run build && npm run build:desktop && node tools/dev-desktop.mjs --smoke-test",
    "refresh:runtime": "node tools/refresh-runtime.mjs",
    "configure-local": "node tools/configure-local.mjs",
    "test:setup": "npm run build && node --test dist/tests/integration/self-setup-50.test.js dist/tests/management/self-setup.test.js dist/tests/management/voice-setup.test.js dist/tests/providers/voice-enrollment.test.js dist/tests/providers/registered-voices.test.js",
    "test:emotion": "npm run build && node --test dist/tests/memory/emotion-state.test.js dist/tests/providers/emotion-inference.test.js dist/tests/integration/emotion-state-51.test.js dist/tests/integration/emotion-http-51.test.js dist/tests/integration/emotion-review.test.js",
    "test:emotion:ui": "node --test tests/management/emotion-ui.test.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "electron": "44.4.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "pinyin-pro": "3.29.4",
    "qrcode": "1.5.4",
    "sherpa-onnx-node": "1.13.8",
    "silk-wasm": "3.7.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "electron@44.4.1": true
  }
}
